# =========================
# Server (Go Backend)
# =========================
# 数据库文件
*.db
*.db-journal

# Go 编译产物 (忽略 server 目录下的二进制文件)
/server/main
/server/main.exe
/server/server
/server/server.exe

# =========================
# Client (Next.js Frontend)
# =========================
# 依赖包 (所有目录下的 node_modules 都会被忽略)
node_modules/

# Next.js 编译产物
.next/
out/
build/
dist/

# 环境变量 (不要提交密钥！)
.env
.env*.local

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript 增量构建缓存
*.tsbuildinfo
next-env.d.ts