# =========================
# Global / OS (全局通用)
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# =========================
# Server (Python / Django Backend)
# =========================
# Python 编译的字节码和缓存文件 (最容易搞脏代码库的罪魁祸首)
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境目录 (涵盖常见的虚拟环境命名)
.venv/
venv/
env/
ENV/

# Django 本地数据库文件 (测试数据千万别提交)
db.sqlite3
*.sqlite3
*.db
*.db-journal

# Django 用户上传的媒体文件目录 (如果有的话)
media/

# Ruff 格式化和 Pytest 测试的缓存
.ruff_cache/
.pytest_cache/

# =========================
# Client (Next.js Frontend)
# =========================
# 依赖包
node_modules/

# Next.js 编译产物
.next/
out/
build/
dist/

# 环境变量 (不要提交密钥！)
.env
.env*.local

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript 增量构建缓存
*.tsbuildinfo
next-env.d.ts